# For CLI/development use only: copy to .env and fill in at least one key.
# The web/desktop app can instead store keys per user via its "API keys" panel.
# Never share a .env that contains a key.
# Pexels:   https://www.pexels.com/api/
PEXELS_API_KEY=
# Unsplash: https://unsplash.com/developers  (use the "Access Key")
UNSPLASH_ACCESS_KEY=

# Which provider to use when both keys are set: pexels | unsplash
BACKGROUND_PROVIDER=pexels

# rembg model: u2net (default), isnet-general-use, birefnet-general, bria-rmbg, u2net_human_seg, ...
REMBG_MODEL=isnet-general-use
